# tokenhub crawler — environment template (07 5.2 .env.example / P0-1 CLI convention)
#
# Copy to crawler/.env and fill in. crawler/.env is gitignored (07 5.2 data/ not
# in git, 07 8.5 secrets never committed). Precedence at runtime:
#   process environment  >  this file  >  built-in defaults (see config.py).
# Generate a Fernet key with:
#   python -c "import crypto,sys; sys.path.insert(0,'crawler'); print(crypto.generate_fernet_key().decode())"

# --- discovery / aggregator -------------------------------------------------
# Third-party aggregator for linux.sb. MUST send UA below or it answers 403
# (07 3, 02 A.3). limit is capped at 100 and `page` is ignored, so there is no
# paging — discovery relies on the tid watermark cursor instead.
AGG_API_BASE=https://linuxsb.tux298.com/api/latest

# Browser-like UA; the aggregator rejects the default curl/python UA.
UA=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36

# Forum ids to follow (07 5.2: 2,8,3). Non-numeric entries are dropped.
FORUMS=2,8,3

# --- storage ----------------------------------------------------------------
# SQLite path. data/ (db, feed.xml, reports/) is gitignored (07 5.2).
DB_PATH=crawler/data/tokenhub.db

# --- secrets ----------------------------------------------------------------
# Fernet key for token_keys.key_encrypted. REQUIRED before any B-class post can
# be stored; unset = credentials are skipped (warn + alert), never stored in the
# clear (07 8.5). Treat as a secret: do not commit, do not log.
FERNET_KEY=

# DingTalk webhook for operational alerts (07 4 "运维告警"). The URL carries an
# access_token, so config --print-config and the alerter repr redact it fully.
# Empty = NullAlerter (no outbound sink) — fine for local dev / tests.
DINGTALK_WEBHOOK=

# --- feature flags (P0 keeps both off) --------------------------------------
# Probe ladder level 4 (billable POST /chat/completions). 07 5.2 default false.
ENABLE_PAID_PROBE=false

# P2 account-farming slot. D1: not part of P0. Always false here.
ENABLE_ACCOUNT_FARM=false
