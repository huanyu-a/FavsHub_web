# sync-nexus.py 配置模板
#
# 用法：
#   cp nexus-sync.env.example nexus-sync.env   （或 python3 sync-nexus.py --init-config）
#   然后按你的实际情况修改下面各项，用 python3 sync-nexus.py --print-config 确认生效值。
#
# 注意：以下路径都指「服务器宿主」上的位置，不是容器内路径。
#       容器内没有 sqlite3，new-api 库与评测目录也不在容器挂载范围内。
#
# 优先级：命令行参数 > 环境变量 > 本文件 > 内置默认（/opt/app/... 只是占位，务必改成你自己的）

# new-api 的 SQLite 库（宿主路径，脚本只读它的 channels 表）
NEWAPI_DB=/opt/app/new-api/data/one-api.db

# 评测结果目录，内含 eval_latest.json / channel_eval_latest.json
EVAL_DIR=/opt/app/eval_api

# 本站 FavsHub 的 SQLite 库（宿主上的 data/favshub.db，脚本会写 nexus_* 两张表）
FAVSHUB_DB=/opt/app/data/favshub.db

# 你自己的域名，逗号分隔。命中的 deal 永不参与 Nexus 匹配，避免自家域互相误匹配。
OWN_DOMAINS=bx9y.com.cn

# 参与聚合的评测文件名，逗号分隔（按顺序合并，同一渠道的多次探测累加）
EVAL_FILES=eval_latest.json,channel_eval_latest.json
