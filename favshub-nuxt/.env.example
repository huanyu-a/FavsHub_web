# JWT Secret - set this in production (optional, auto-generated if not set)
NUXT_JWT_SECRET=

# Database path (relative to server working dir)
NUXT_DB_PATH=./data/favshub.db

# CORS origin
NUXT_CORS_ORIGIN=http://localhost:3000

# Admin users (comma-separated usernames, optional)
NUXT_ADMIN_USERS=

# 站点对外地址（canonical / og:url / og:image / sitemap.xml 用）
NUXT_PUBLIC_BASE_URL=https://hao.bx9y.com.cn

# Server port
PORT=3001
